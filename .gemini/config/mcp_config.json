{
  "mcpServers": {
    "atlassian-local": {
      "command": "bash",
      "args": [
        "-c",
        "HTTPS_PROXY=\"$ATLASSIAN_PROXY_URL\" HTTP_PROXY=\"$ATLASSIAN_PROXY_URL\" uvx mcp-atlassian"
      ],
      "disabled": false,
      "env": {
        "CONFLUENCE_URL": "https://thudojsc.atlassian.net/wiki",
        "JIRA_URL": "https://thudojsc.atlassian.net"
      }
    },
    "figma": {
      "args": ["-y", "figma-developer-mcp", "--stdio"],
      "command": "npx",
      "disabled": true
    },
    "google-workspace": {
      "args": [
        "workspace-mcp",
        "--single-user",
        "--tool-tier",
        "core",
        "--tools",
        "drive",
        "docs",
        "sheets",
        "calendar",
        "chat",
        "gmail"
      ],
      "command": "uvx",
      "disabled": false
    }
  }
}
